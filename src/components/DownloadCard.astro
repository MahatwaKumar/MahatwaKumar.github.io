---
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
interface Item { label: string; file: string; description?: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'Downloads' } = Astro.props;
const size = (f: string) => {
  try {
    const b = fs.statSync(path.join(process.cwd(), 'public', f)).size;
    return b > 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
  } catch {
    throw new Error(`Download not found in public/: ${f}`);
  }
};
---
{items.length > 0 && (
  <section class="downloads card" aria-labelledby="dl-title">
    <h2 id="dl-title" class="h">{title}</h2>
    <ul>
      {items.map((it) => (
        <li>
          <a href={it.file} download>
            <span class="ic"><Icon name="file" /></span>
            <span class="txt">
              <span class="l">{it.label}</span>
              {it.description && <span class="d">{it.description}</span>}
            </span>
            <span class="sz">PDF · {size(it.file)}</span>
            <Icon name="download" class="dl" />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .downloads { padding: var(--s5); margin: var(--s6) 0; }
  .h { font-size: var(--fs-lg); margin-bottom: var(--s3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  a {
    display: flex; align-items: center; gap: var(--s3); min-height: 56px; padding: var(--s3); border-radius: var(--radius);
    border: 1px solid var(--border); color: var(--text); text-decoration: none; background: var(--surface-2);
  }
  a:hover { border-color: var(--accent); }
  .ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; background: var(--accent-soft); color: var(--accent); flex: none; }
  .ic :global(svg), :global(.dl) { width: 20px; height: 20px; }
  .txt { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .l { font-weight: 600; }
  .d { font-size: var(--fs-sm); color: var(--text-muted); }
  .sz { font: var(--fs-xs) var(--font-mono); color: var(--text-faint); white-space: nowrap; }
  :global(.dl) { color: var(--text-muted); flex: none; }
</style>
