---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import SoftwareChips from './SoftwareChips.astro';
import KeyResults from './KeyResults.astro';
interface Props { project: CollectionEntry<'projects'>; eager?: boolean; headingLevel?: 'h3' | 'h2' }
const { project, eager = false, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const H = headingLevel;
---
<article class="pcard" data-tags={d.tags.join(' ')} data-order={d.order}>
  <a class="media" href={`/projects/${d.slug}/`} tabindex="-1" aria-hidden="true">
    <Image
      src={d.heroImage}
      alt=""
      widths={[400, 640, 900].filter((w) => w <= d.heroImage.width)}
      sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      transition:name={`hero-${d.slug}`}
    />
  </a>
  <div class="body">
    <div class="meta"><StatusBadge status={d.status} /></div>
    <H class="title"><a href={`/projects/${d.slug}/`}>{d.shortTitle ?? d.title}</a></H>
    <p class="sum">{d.cardSummary}</p>
    <KeyResults items={d.keyResults.slice(0, 2)} compact />
    <div class="foot"><SoftwareChips items={d.software} max={4} /></div>
  </div>
</article>

<style>
  .pcard {
    position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s var(--ease), border-color 0.25s, transform 0.25s var(--ease);
  }
  .pcard:hover { box-shadow: var(--shadow-lg); border-color: var(--border-strong); }
  .pcard:focus-within { border-color: var(--accent); }
  .media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--plate); border-bottom: 1px solid var(--border); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .pcard:hover .media img { transform: scale(1.045); }
  .body { display: flex; flex-direction: column; gap: var(--s3); padding: var(--s5); flex: 1; }
  .title { font-size: var(--fs-lg); margin: 0; }
  .title a { color: var(--text); text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 1; } /* whole card is clickable */
  .title a:focus-visible { outline: none; }
  .pcard:has(.title a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .sum { color: var(--text-muted); font-size: var(--fs-sm); margin: 0; }
  .foot { margin-top: auto; padding-top: var(--s2); }
  @media (prefers-reduced-motion: reduce) { .pcard:hover .media img { transform: none; } }
</style>
