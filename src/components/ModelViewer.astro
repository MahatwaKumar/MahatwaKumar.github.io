---
// Interactive 3D viewer. The model-viewer library (and the model) only load once the viewer scrolls into view.
import Icon from './Icon.astro';
interface Hotspot { position: string; normal?: string; label: string }
interface Props {
  src: string;               // /models/<slug>.glb
  alt: string;
  poster?: string;
  caption?: string;
  label?: string;            // name of the main model (for the toggle)
  compareSrc?: string;       // optional second model (e.g. baseline)
  compareLabel?: string;
  cameraOrbit?: string;
  hotspots?: Hotspot[];
  height?: string;
  variant?: 'card' | 'hero';
  loadOn?: 'visible' | 'interaction'; // 'interaction' waits for the visitor's first scroll, tap, key or mouse move
}
const { src, alt, poster, caption, label = 'Final design', compareSrc, compareLabel = 'Baseline', cameraOrbit = '35deg 72deg auto', hotspots = [], height = 'clamp(320px, 52vw, 560px)', variant = 'card', loadOn = 'visible' } = Astro.props;
---
<figure class:list={['mv', variant]} data-mv data-load-on={loadOn}>
  <div class="frame" style={`height:${height}`}>
    <model-viewer
      data-src={src}
      alt={alt}
      camera-controls
      touch-action="pan-y"
      auto-rotate
      auto-rotate-delay="0"
      rotation-per-second="18deg"
      interaction-prompt="none"
      shadow-intensity="0.9"
      shadow-softness="0.9"
      exposure="0.95"
      tone-mapping="neutral"
      environment-image="neutral"
      camera-orbit={cameraOrbit}
      min-camera-orbit="auto auto 5%"
      interpolation-decay="120"
      loading="lazy"
      reveal="auto"
    >
      {hotspots.map((h, i) => (
        <button class="hotspot" slot={`hotspot-${i}`} data-position={h.position} data-normal={h.normal ?? '0m 1m 0m'} data-visibility-attribute="visible" aria-label={h.label}>
          <span class="hs-dot" aria-hidden="true"></span><span class="hs-label">{h.label}</span>
        </button>
      ))}
      <div slot="progress-bar" class="loadbar" aria-hidden="true"><span></span></div>
    </model-viewer>
    {poster
      ? <img class="poster-img" src={poster} alt="" aria-hidden="true" decoding="async" fetchpriority={variant === 'hero' ? 'high' : 'auto'} loading={variant === 'hero' ? 'eager' : 'lazy'} />
      : <div class="placeholder" aria-hidden="true"><Icon name="cube" /><span>Loading 3D model…</span></div>}
    <div class="controls">
      {compareSrc && (
        <div class="toggle" role="group" aria-label="Choose model">
          <button type="button" aria-pressed="true" data-model={src}>{label}</button>
          <button type="button" aria-pressed="false" data-model={compareSrc}>{compareLabel}</button>
        </div>
      )}
      <button type="button" class="ctl" data-reset aria-label="Reset view" title="Reset view"><Icon name="reset" /></button>
      <button type="button" class="ctl" data-fullscreen aria-label="View 3D model full screen" title="Full screen"><Icon name="maximize" /></button>
    </div>
    <p class="hint" aria-hidden="true">Drag to rotate · scroll or pinch to zoom</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { initModelViewers } from '../lib/model-viewer-client';
  document.addEventListener('astro:page-load', initModelViewers);
</script>

<style>
  .mv { margin: var(--s6) 0; }
  .frame {
    position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border);
    background: radial-gradient(120% 90% at 50% 20%, var(--surface) 0%, var(--surface-2) 70%, var(--bg-alt) 100%);
  }
  .hero .frame { border: 0; background: transparent; }
  model-viewer { width: 100%; height: 100%; --poster-color: transparent; background: transparent; }
  .placeholder { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--s2); color: var(--text-faint); font-size: var(--fs-sm); pointer-events: none; transition: opacity 0.3s; }
  .placeholder :global(svg) { width: 40px; height: 40px; opacity: 0.6; }
  .mv[data-loaded] .placeholder, .mv[data-loaded] .loadbar, .mv[data-loaded] .poster-img { opacity: 0; }
  .poster-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; transition: opacity 0.4s; }
  .loadbar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: transparent; }
  .loadbar span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--accent); transition: width 0.2s; }
  .controls { position: absolute; right: var(--s3); bottom: var(--s3); display: flex; gap: var(--s2); align-items: center; z-index: 2; }
  .ctl, .toggle button {
    min-height: 44px; min-width: 44px; display: inline-grid; place-items: center; border-radius: var(--radius); cursor: pointer;
    border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 88%, transparent); color: var(--text); backdrop-filter: blur(6px);
  }
  .ctl :global(svg) { width: 18px; height: 18px; }
  .ctl:hover, .toggle button:hover { border-color: var(--accent); }
  .toggle { display: flex; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
  .toggle button { border: 0; border-radius: 0; padding: 0 var(--s3); font: 600 var(--fs-xs) var(--font-sans); }
  .toggle button[aria-pressed='true'] { background: var(--accent); color: var(--accent-contrast); }
  .hint { position: absolute; left: var(--s4); bottom: var(--s3); margin: 0; font-size: var(--fs-xs); color: var(--text-faint); pointer-events: none; }
  @media (max-width: 560px) { .hint { display: none; } }
  .hotspot {
    display: flex; align-items: center; gap: 6px; padding: 0 4px; border: 0; background: none; cursor: pointer; min-height: 44px; min-width: 44px;
    --min-hotspot-opacity: 0;
  }
  .hotspot:not([data-visible]) { opacity: 0.25; }
  .hs-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid #fff; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .hs-label {
    font: 600 11px/1.3 var(--font-sans); padding: 3px 8px; border-radius: 6px; white-space: nowrap;
    background: rgb(14 23 38 / 0.82); color: #fff;
  }
  figcaption { margin-top: var(--s2); font-size: var(--fs-sm); color: var(--text-muted); max-width: var(--measure); }
  .mv:fullscreen .frame, .frame:fullscreen { height: 100vh !important; border-radius: 0; background: var(--bg); }
</style>
