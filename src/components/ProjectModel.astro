---
// The project's main CAD model, taken from the project's frontmatter (model3d).
import { getEntry } from 'astro:content';
import ModelViewer from './ModelViewer.astro';
interface Props { id: string; caption?: string }
const { id, caption } = Astro.props;
const entry = await getEntry('projects', id);
const m = entry?.data.model3d;
---
{m && (
  <div id="model-3d">
    <ModelViewer
      src={m.src}
      alt={m.alt}
      poster={m.poster}
      label={m.label}
      compareSrc={m.compareSrc}
      compareLabel={m.compareLabel}
      cameraOrbit={m.cameraOrbit}
      hotspots={m.hotspots}
      caption={caption}
    />
  </div>
)}
