---
import { statusLabels, type Status } from '../lib/site';
interface Props { status: Status; size?: 'sm' | 'md' }
const { status, size = 'sm' } = Astro.props;
---
<span class:list={['badge', `badge-${status}`, size]}>
  <span class="dot" aria-hidden="true"></span>{statusLabels[status]}
</span>

<style>
  .badge {
    display: inline-flex; align-items: center; gap: 7px; padding: 3px 10px; border-radius: 999px;
    font: 600 var(--fs-xs)/1.5 var(--font-sans); white-space: nowrap; border: 1px solid transparent;
  }
  .badge.md { font-size: var(--fs-sm); padding: 5px 12px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .badge-complete { color: var(--ok); background: var(--ok-bg); border-color: color-mix(in srgb, var(--ok) 25%, transparent); }
  .badge-build-in-progress { color: var(--warn); background: var(--warn-bg); border-color: color-mix(in srgb, var(--warn) 25%, transparent); }
  .badge-in-progress { color: var(--info); background: var(--info-bg); border-color: color-mix(in srgb, var(--info) 25%, transparent); }
</style>
