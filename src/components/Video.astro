---
// A demo or simulation video. Nothing downloads until the visitor presses play (preload="none").
interface Props {
  src: string;        // "/videos/<slug>/<file>.mp4"
  poster: string;     // still shown before playing
  title: string;      // accessible name of the player
  caption: string;
  width: number;
  height: number;
  duration?: string;  // shown in the caption, e.g. "0:29"
}
const { src, poster, title, caption, width, height, duration } = Astro.props;
---
<figure class="video reveal">
  <div class="frame" style={`aspect-ratio: ${width} / ${height}`}>
    <video controls playsinline preload="none" poster={poster} width={width} height={height} aria-label={title}>
      <source src={src} type="video/mp4" />
      <a href={src}>Download the video ({title})</a>
    </video>
  </div>
  <figcaption>{caption}{duration && <span class="dur"> · {duration}, no sound</span>}</figcaption>
</figure>

<style>
  .video { margin: var(--s6) 0; }
  .frame { background: #0b1220; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  video { display: block; width: 100%; height: 100%; object-fit: contain; }
  figcaption { margin-top: var(--s2); font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.5; max-width: var(--measure); }
  .dur { font-family: var(--font-mono); font-size: var(--fs-xs); }
</style>
